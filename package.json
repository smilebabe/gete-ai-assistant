{
  "name": "gete-ai-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/assistant-api run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/**/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
